# ─── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Google Sheets ─────────────────────────────────────────────────────────────
# Paste the full JSON of your Google Service Account key as a single-line string
GOOGLE_SHEETS_CREDS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-sa@project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# The ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# The exact name of the worksheet tab to write posts into
GOOGLE_SHEET_TAB=PostQueue

# ─── Make.com ──────────────────────────────────────────────────────────────────
MAKE_WEBHOOK_URL=https://hook.make.com/your_webhook_id_here

# ─── Agent Behaviour ───────────────────────────────────────────────────────────
# Set to "true" to skip Sheets write and Make.com call (local testing)
DRY_RUN=false

# Number of top stories to select (default: 5)
TOP_STORIES_COUNT=5

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash
